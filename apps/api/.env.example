APP_NAME="Bakery Ops"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Inside compose the host names are the service names; the compose file also injects these.
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bakery
DB_USERNAME=bakery
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Live updates poll (ADR 0009): null sends and queues nothing; reverb or pusher (and their keys) switch WebSockets on.
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

AWS_ACCESS_KEY_ID=bakery
AWS_SECRET_ACCESS_KEY=bakerysecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=bakery
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/bakery
AWS_USE_PATH_STYLE_ENDPOINT=true

REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=ws
REVERB_PORT=8080
REVERB_SCHEME=http

SANCTUM_STATEFUL_DOMAINS=
# Origins allowed to call /api cross-origin (comma separated). Local: the web shell on `next start`.
# Production: leave empty; the shell is served from the API's own origin under /app/ (ADR 0006, 0007).
CORS_ALLOWED_ORIGINS=http://localhost:3000
BAKERY_TIMEZONE=Africa/Addis_Ababa
BAKERY_CURRENCY=ETB
# The demo bakery (php artisan bakery:seed-demo, docs/runbook/server.md). Locally and in tests the demo accounts use
# the documented password in database/seeders/Demo/DemoCredentials.php; anywhere else BAKERY_DEMO_PASSWORD is required.
#BAKERY_DEMO_BRANCH="Demo Bakery"
#BAKERY_DEMO_PASSWORD=

# Notification drivers (phase 2, section 10.1). Every driver ships OFF and these stay EMPTY in the repository: the real values
# live only in the server .env (docs/runbook/server.md, "Turning on web push and Telegram"). A driver is on only when its flag
# is true AND all its settings are present; `php artisan notifications:status` says which are on and what is missing.
# Web push (VAPID): keys come from `php artisan notifications:vapid-keys`.
NOTIFY_PUSH_ENABLED=
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Telegram: the bot is made with @BotFather; the webhook secret is a long random string; then `php artisan notifications:telegram-webhook`.
NOTIFY_TELEGRAM_ENABLED=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# CI and tests only: a driver that records what it was asked to send instead of reaching any service. Never on the live host.
NOTIFY_ARRAY_ENABLED=false
# Shift enforcement in the stock ledger (phase 3, config/ledger.php). OFF everywhere until step 3.7e; true makes the ledger refuse a
# stock movement at a station with no open shift (docs/runbook/server.md, "Shift enforcement in the ledger").
LEDGER_REQUIRE_SHIFT_FOR_STATION_LOCATIONS=false
# The call-in (phase 3, config/shifts.php): when true, a baker who accepts a production request at a station with no running shift opens an
# ad-hoc shift. OFF everywhere until step 3.7e gives staff a way to see and close shifts (docs/runbook/server.md, "Shifts and the call-in").
SHIFTS_OPEN_AD_HOC_ON_ACCEPT=false
# Shift rule for cash (phase 3, config/payments.php): when true, a cash payment is refused (409 payments.shift.required) unless the cashier
# carries an open shift. OFF everywhere until step 3.7e (docs/runbook/server.md, "Shift rule for cash").
PAYMENTS_REQUIRE_SHIFT_FOR_CASH=false
