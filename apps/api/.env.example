APP_NAME="Bakery Ops"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Inside compose the host names are the service names; the compose file also injects these.
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=bakery
DB_USERNAME=bakery
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

AWS_ACCESS_KEY_ID=bakery
AWS_SECRET_ACCESS_KEY=bakerysecret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=bakery
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/bakery
AWS_USE_PATH_STYLE_ENDPOINT=true

REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=ws
REVERB_PORT=8080
REVERB_SCHEME=http

SANCTUM_STATEFUL_DOMAINS=
# Origins allowed to call /api cross-origin (comma separated). Local: the web shell on `next start`.
# Production: leave empty; the shell is served from the API's own origin under /app/ (ADR 0006, 0007).
CORS_ALLOWED_ORIGINS=http://localhost:3000
BAKERY_TIMEZONE=Africa/Addis_Ababa
BAKERY_CURRENCY=ETB
# The demo bakery (php artisan bakery:seed-demo, docs/runbook/server.md). Locally and in tests the demo accounts use
# the documented password in database/seeders/Demo/DemoCredentials.php; anywhere else BAKERY_DEMO_PASSWORD is required.
#BAKERY_DEMO_BRANCH="Demo Bakery"
#BAKERY_DEMO_PASSWORD=
