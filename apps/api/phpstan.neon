includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - app
        - database
        - routes
    # tests/ are Pest closures; PHPStan cannot type $this inside them without the Pest plugin,
    # and the tests prove themselves by running. Application code stays at level 8.
    tmpDir: tmp/phpstan
