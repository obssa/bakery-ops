APP_NAME="Bakery Ops"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
LOG_CHANNEL=stderr
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bakery_test
DB_USERNAME=bakery
DB_PASSWORD=secret
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
MAIL_MAILER=array
BAKERY_TIMEZONE=Africa/Addis_Ababa
BAKERY_CURRENCY=ETB
# CI only: the array driver records notifications instead of sending them; every real driver (push, Telegram) stays off
NOTIFY_ARRAY_ENABLED=true
# The three shift rules are ON, as in the code defaults (step 3.7e); the flags-off side (the kill switch) is rehearsed by the enforced-gates job
LEDGER_REQUIRE_SHIFT_FOR_STATION_LOCATIONS=true
SHIFTS_OPEN_AD_HOC_ON_ACCEPT=true
PAYMENTS_REQUIRE_SHIFT_FOR_CASH=true
