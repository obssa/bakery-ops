// bakery-ops ERD (DBML). Regenerated/extended every phase; scripts/erd_check.py fails CI when a
// migration creates a table that is not documented here. Laravel's framework tables are listed
// so the check stays honest; domain tables are added as their migrations land.

Project bakery_ops {
  database_type: 'MySQL'
  Note: 'Phase 0 as built (closed at step 0.9). Money DECIMAL(12,2), quantities DECIMAL(14,4) in base units. branch_id on every tenant table. Live engine MariaDB 10.11 (ADR 0006; CI and the local stack run the same image); schema kept portable to PostgreSQL.'
}

// ---- Laravel framework tables (shipped with the scaffold)
Table users {
  id bigint [pk]
  branch_id bigint [ref: > branches.id]
  name varchar
  phone varchar(20)
  email varchar
  password varchar
  short_code_hash varchar
  short_code_attempts smallint
  pin_locked_until timestamp
  locale char(2)
  is_active boolean
  photo_url varchar(2048)
  remember_token varchar
  created_at timestamp
  updated_at timestamp
  deleted_at timestamp
  Note: 'step 0.4 (Identity): the scaffold table extended by 2026_10_19_000200; phone is the login id, unique (branch_id, phone); short_code_hash is argon2id, never shown after creation; locale CHECK users_locale_check in (en, am); roles/permissions via spatie tables (guard web); soft deletes'
}
Table personal_access_tokens { id bigint [pk]  tokenable_type varchar  tokenable_id bigint  name text  token varchar(64) [unique]  abilities text  last_used_at timestamp  expires_at timestamp  created_at timestamp  updated_at timestamp  Note: 'step 0.4; Sanctum bearer tokens (ADR 0007), published migration; global (no branch_id): the tokenable user carries the branch' }
Table permissions { id bigint [pk]  name varchar(125)  guard_name varchar(125)  created_at timestamp  updated_at timestamp  Note: 'step 0.4; spatie/laravel-permission; names from PermissionRegistry (App.Modules.Identity.Contracts), seeded by RolesSeeder; global by design (unique (name, guard_name))' }
Table roles { id bigint [pk]  name varchar(125)  guard_name varchar(125)  created_at timestamp  updated_at timestamp  Note: 'step 0.4; admin, manager, cashier, waiter, chef, barista, cake_baker, bread_baker; global (unique (name, guard_name))' }
Table model_has_permissions { permission_id bigint [ref: > permissions.id]  model_type varchar  model_id bigint  Note: 'step 0.4; per-user permission overrides (direct grants); primary (permission_id, model_id, model_type)' }
Table model_has_roles { role_id bigint [ref: > roles.id]  model_type varchar  model_id bigint  Note: 'step 0.4; one role per user by convention (syncRoles); primary (role_id, model_id, model_type)' }
Table role_has_permissions { permission_id bigint [ref: > permissions.id]  role_id bigint [ref: > roles.id]  Note: 'step 0.4; the section 7 matrix; primary (permission_id, role_id)' }
Table password_reset_tokens { email varchar [pk]  token varchar  created_at timestamp }
Table sessions { id varchar [pk]  user_id bigint  ip_address varchar  user_agent text  payload text  last_activity int }
Table cache { key varchar [pk]  value text  expiration int }
Table cache_locks { key varchar [pk]  owner varchar  expiration int }
Table jobs { id bigint [pk]  queue varchar  payload text  attempts smallint  reserved_at int  available_at int  created_at int }
Table job_batches { id varchar [pk]  name varchar  total_jobs int  pending_jobs int  failed_jobs int  failed_job_ids text  options text  cancelled_at int  created_at int  finished_at int }
Table failed_jobs { id bigint [pk]  uuid varchar [unique]  connection text  queue text  payload text  exception text  failed_at timestamp }

// ---- Phase 0 domain tables (branches, stations, idempotency_keys: step 0.2; audit_log: 0.3; Catalog: 0.5; Inventory: locations, stock_movements, stock_balances and the item_stock_view view: 0.6)
Table branches { id bigint [pk]  name varchar(120)  timezone varchar(64)  currency char(3)  settings json  catalog_version bigint  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'the tenant (step 0.2); timezone defaults to Africa/Addis_Ababa, currency to ETB; settings is plain JSON (no DB default, the model supplies {}); catalog_version (step 1.7, default 0) is bumped by one on every save or delete of the catalog models behind GET /menu (Catalog BumpsCatalogVersion), so the menu ETag changes for every catalog edit, even two inside one second' }
Table stations { id bigint [pk]  branch_id bigint [ref: > branches.id]  code varchar(20)  name_en varchar(120)  name_am varchar(120)  requires_overseer boolean  tracks_shifts boolean  sort smallint  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 0.2; code in till|kitchen|bar|cake_room|bakery|store (CHECK constraint stations_code_check); unique (branch_id, code); tracks_shifts (step 3.1a, default true, backfilled false for the store) = does this station run shifts at all: the ledger check, the counts and the roster apply only where it is true' }
Table idempotency_keys { id bigint [pk]  branch_id bigint [ref: > branches.id]  user_id bigint  key varchar(255)  request_hash char(64)  response_status smallint  response_body json  expires_at timestamp  created_at timestamp  updated_at timestamp  Note: 'step 0.2; unique (branch_id, user_id, key); user_id has no FK (Shared is the leaf, ADR 0001); index expires_at' }
Table stored_files { id bigint [pk]  branch_id bigint [ref: > branches.id]  client_uuid char(36)  purpose varchar(24)  disk varchar(24)  key varchar(255)  mime varchar(32)  bytes int  width smallint  height smallint  sha256 char(64)  uploaded_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  shift_instance_id bigint [ref: > shift_instances.id]  station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  attached_type varchar(24)  attached_id bigint  attached_at datetime  created_at datetime  updated_at datetime  deleted_at datetime  Note: 'step 4.2a (phase-4 M1): one row per stored object of App.Shared.Files.Files; key is receipts/{branch_id}/{yyyy}/{mm}/{uuid}.jpg (unique, no original name), disk says where the object lives (files or files_s3), sha256 is of the stored re-encoded JPEG; purpose in (receipt, refund_proof) by CHECK stored_files_purpose_check; attached_* is what claimed the file (payment, payment_refund), null while it is an orphan the 24 h purge removes (step 4.2b); soft-deleted; unique (branch_id, client_uuid); indexes (branch_id, sha256), (attached_type, attached_id), (branch_id, attached_at, created_at)' }
Table audit_log { id bigint [pk]  branch_id bigint [ref: > branches.id]  actor_id bigint  acting_user_id bigint  action varchar(100)  subject_type varchar(191)  subject_id bigint  before json  after json  context json  shift_instance_id bigint  station_id bigint  device_id bigint  ip varchar(45)  at timestamp  Note: 'step 0.3; append-only: triggers audit_log_forbid_update_delete_{update,delete} (MySQL SIGNAL 45000) / forbid_update_delete() (PostgreSQL); written by AuditedAction in the write transaction; no timestamps, no soft delete; actor/acting/shift/station/device ids have no FK (Audit is a leaf, ADR 0001); indexes (branch_id, at), (subject_type, subject_id), and from step 4.5a (M17, 2026_11_08_100100) (branch_id, id), (branch_id, action, id), (branch_id, subject_type, subject_id, id), (branch_id, actor_id, id), (branch_id, acting_user_id, id) for the read API; context = reason/notes that are not subject attributes (redacted like the snapshots from step 4.5a); recordEvent() stores its payload in after' }
Table units { id bigint [pk]  code varchar(16) [unique]  name_en varchar(60)  name_am varchar(60)  base_unit_id bigint [ref: > units.id]  factor "decimal(14,4)"  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 0.5 (Catalog); global reference data, no branch_id (BRANCH_ALLOWLIST); a base unit has no base and factor 1, a derived unit converts to its base by factor (CHECK units_factor_positive factor > 0); the migration inserts g, ml, pcs (base) and kg (1000 g), L (1000 ml), slice (1 pcs), tray (12 pcs); Units::toBase = qty x factor at 4 dp' }
Table categories { id bigint [pk]  branch_id bigint [ref: > branches.id]  kind varchar(20)  name_en varchar(120)  name_am varchar(120)  parent_id bigint [ref: > categories.id]  sort smallint  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 0.5; kind in ingredient|product (CHECK categories_kind_check); a parent has the same kind and branch; soft delete refused while live items or sub-categories remain; index (branch_id, kind, sort)' }
Table items { id bigint [pk]  branch_id bigint [ref: > branches.id]  kind varchar(20)  fulfilment varchar(20)  name_en varchar(160)  name_am varchar(160)  category_id bigint [ref: > categories.id]  unit_id bigint [ref: > units.id]  sku varchar(64)  is_active boolean  is_new_until date  default_batch_qty "decimal(14,4)"  production_station_id bigint [ref: > stations.id]  refundable boolean  refund_restock boolean  created_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  shift_instance_id bigint [ref: > shift_instances.id]  station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 0.5; both inventories (rule 2): kind in ingredient|product (CHECK items_kind_check), fulfilment in to_order|to_stock|bought_in (CHECK items_fulfilment_check; ingredients are always bought_in); unique (branch_id, sku); stock is in the base unit of unit_id, so unit_id only changes within the same base; is_new_until is a date in the branch calendar (Items::isNew, inclusive); production_station_id = the station that makes a display-case product; actor stamp created_by_user_id .. device_id (rule 4; shift_instance_id has its FK to shift_instances since step 3.2a); soft deletes; step 4.1b (2026_11_09_100100, Ramin answer to R-C): refundable BOOLEAN NOT NULL DEFAULT TRUE (may the product be refunded) and refund_restock BOOLEAN NOT NULL DEFAULT FALSE (does a refunded unit go back into stock: only a product sold from stock or bought in, never one made to order or an ingredient), set by the admin, read by Orders through Catalog.Contracts.RefundPolicy; backfilled once: restock on for to_stock and bought_in products, refundable off for ingredients' }
Table item_prices { id bigint [pk]  branch_id bigint [ref: > branches.id]  item_id bigint [ref: > items.id]  price "decimal(12,2)"  currency char(3)  effective_from datetime  effective_to datetime  created_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  shift_instance_id bigint [ref: > shift_instances.id]  station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  created_at timestamp  updated_at timestamp  Note: 'step 0.5; price history, never overwritten or deleted (no deleted_at): a new price closes the open row at its own effective_from; Prices::at reads effective_from inclusive, effective_to exclusive; DATETIME in UTC (no 2038 ceiling, no implicit ON UPDATE); actor stamp; index (item_id, effective_from)' }
Table item_station_assignments { id bigint [pk]  branch_id bigint [ref: > branches.id]  item_id bigint [ref: > items.id]  station_id bigint [ref: > stations.id]  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 0.5; where an order line routes (latte -> bar); none for a display-case product (Routing::stationFor null); unique (item_id, station_id) for the row life: withdrawn rows are soft-deleted and restored' }
Table recipes { id bigint [pk]  branch_id bigint [ref: > branches.id]  product_item_id bigint [ref: > items.id]  yield_qty "decimal(14,4)"  yield_unit_id bigint [ref: > units.id]  version int  is_active boolean  published_at datetime  published_by_user_id bigint [ref: > users.id]  change_note varchar(255)  active_product_key bigint  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 0.5, extended at step 2.4a (migration 2026_10_22_130100); version 1 created or replaced by PUT /items/{item}/recipe (in place only while it is the only version, then 409 catalog.recipe.published), every further version published by POST /items/{item}/recipe/versions (RecipeBook::publish: the active one is set inactive, version max + 1 inserted active, in one transaction); published_at / published_by_user_id / change_note say when, by whom and why (published_at backfilled from created_at, published_by null for version 1); one live active version per product, guaranteed by the database: active_product_key is a STORED generated column (CASE WHEN is_active = 1 AND deleted_at IS NULL THEN product_item_id END) under UNIQUE recipes_one_active on MariaDB/MySQL, a partial unique index recipes_one_active (product_item_id) WHERE is_active AND deleted_at IS NULL on PostgreSQL; unique (product_item_id, version); old versions stay readable by Recipes::version; a bought-in product has none (Recipes::activeFor returns the empty view)' }
Table recipe_lines { id bigint [pk]  branch_id bigint [ref: > branches.id]  recipe_id bigint [ref: > recipes.id]  ingredient_item_id bigint [ref: > items.id]  qty "decimal(14,4)"  unit_id bigint [ref: > units.id]  is_optional boolean  waste_pct "decimal(5,2)"  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 0.5; per yield, in any unit that converts to the ingredient base unit (Recipes::activeFor answers in base units); the ingredient may be a product (2 slices of bread); waste_pct is a percentage 0 <= w < 100; replaced lines are soft-deleted' }
Table recipe_steps { id bigint [pk]  branch_id bigint [ref: > branches.id]  recipe_id bigint [ref: > recipes.id]  step_order smallint  text_en text  text_am text  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 0.5; the bilingual method shown on the production card; replaced steps are soft-deleted; index (recipe_id, step_order)' }
Table modifiers { id bigint [pk]  branch_id bigint [ref: > branches.id]  item_id bigint [ref: > items.id]  name_en varchar(120)  name_am varchar(120)  price_delta "decimal(12,2)"  recipe_delta json  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 0.5; no onion, large size; recipe_delta = [{ingredient_item_id, qty (signed decimal string), unit_id}] (plain JSON, not JSONB), converted to base units by Modifiers::for' }
Table locations { id bigint [pk]  branch_id bigint [ref: > branches.id]  name_en varchar(120)  name_am varchar(120)  station_id bigint [ref: > stations.id]  type varchar(20)  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 0.6 (Inventory); where stock is held: stock is per location (kitchen flour and bakery flour are different piles); type in store|kitchen|bar|cake_room|bakery|display_case|cash_drawer (CHECK locations_type_check), fixed once created; station_id = the station that works from it (availability of its lines is computed here); bilingual names (rule 9); configuration: audited, soft deletes, no actor stamp; index (branch_id, type)' }
Table stock_movements { id bigint [pk]  branch_id bigint [ref: > branches.id]  item_id bigint [ref: > items.id]  from_location_id bigint [ref: > locations.id]  to_location_id bigint [ref: > locations.id]  qty "decimal(14,4)"  reason varchar(32)  ref_type varchar(64)  ref_id bigint  reservation_ref char(36)  shift_instance_id bigint [ref: > shift_instances.id]  user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  client_uuid char(36)  created_at datetime  Note: 'step 0.6; the stock ledger (rule 1, ADR 0002): append-only, triggers stock_movements_forbid_update_delete_{update,delete} (MySQL/MariaDB SIGNAL 45000) / stock_movements_forbid_update_delete with forbid_update_delete() (PostgreSQL); sole writer App.Modules.Inventory.Ledger.Ledger, in the same transaction as the stock_balances row; qty signed in the item base unit: the change of reserved for reservation / reservation_release, else of on_hand, and of both for production_consume / sale carrying a reservation_ref (MovementReason); reason CHECK in purchase_in|transfer|production_consume|production_output|sale|waste|count_adjustment|return|reservation|reservation_release, qty <> 0, from or to set; the row changes to_location_id when stock arrives, from_location_id when it leaves or is held, a transfer is two rows with both ends (the sign picks the side); ref_type/ref_id = what caused it; reservation_ref groups a reservation; unique (branch_id, client_uuid) (ADR 0003); actor stamp user_id .. device_id (rule 4), shift_instance_id FK to shift_instances since step 3.2a; no updated_at, no deleted_at; indexes (branch_id, created_at), (item_id, created_at), reservation_ref, shift_instance_id' }
Table stock_balances { id bigint [pk]  branch_id bigint [ref: > branches.id]  item_id bigint [ref: > items.id]  location_id bigint [ref: > locations.id]  on_hand "decimal(14,4)"  reserved "decimal(14,4)"  updated_at datetime  Note: 'step 0.6; the running balance per (item, location), unique (item_id, location_id) (ADR 0002): upserted by the Ledger in the movement transaction, the row SELECT ... FOR UPDATE locks in ascending (item_id, location_id) order, the read path of Stock::of and Availability; available = on_hand - reserved; CHECK on_hand >= 0 and reserved >= 0; never deleted. View item_stock_view (branch_id, item_id, location_id, on_hand, reserved, available) recomputes the same sums from stock_movements alone (migration 2026_10_19_210400; a plain view, MySQL/MariaDB have no materialized views): the reconciliation oracle of the Phase 0 gate, never a lock target' }
Table item_stock_view { branch_id bigint [ref: > branches.id]  item_id bigint [ref: > items.id]  location_id bigint [ref: > locations.id]  on_hand "decimal(14,4)"  reserved "decimal(14,4)"  available "decimal(14,4)"  Note: 'step 0.6; a VIEW, not a table (DBML has no views): CREATE OR REPLACE VIEW in migration 2026_10_19_210400, the same sums as stock_balances recomputed from stock_movements alone, grouped by (branch_id, item_id, location); on_hand ignores reservation / reservation_release rows, reserved counts them plus production_consume / sale rows that carry a reservation_ref, available = on_hand - reserved; the reconciliation oracle of the Phase 0 gate (LedgerPropertiesTest), never a lock target and never written (ADR 0002); a plain view because MariaDB has no materialized views' }
Table user_station_assignments { id bigint [pk]  branch_id bigint [ref: > branches.id]  user_id bigint [ref: > users.id]  station_id bigint [ref: > stations.id]  can_count boolean  is_overseer boolean  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 0.4; unique (user_id, station_id) for the row's whole life: withdrawn rows are soft-deleted and restored when the station comes back (Stations::replace)' }
Table devices { id bigint [pk]  branch_id bigint [ref: > branches.id]  client_uuid char(36)  name varchar(120)  kind varchar(16)  station_id bigint [ref: > stations.id]  fingerprint varchar(191) [unique]  token_hash char(64) [unique]  enrolled_by bigint [ref: > users.id]  enrolled_at timestamp  revoked_at timestamp  revoked_by bigint [ref: > users.id]  last_seen_at timestamp  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 0.4; fingerprint = the X-Device-Id header; revoked devices are refused at once. Step 5.1a (phase-5 M1, 2026_11_11_100100, ADR 0017): kind tablet|till|kds|bridge DEFAULT tablet (CHECK devices_kind_check, App.Modules.Identity.Enums.DeviceKind; the rows of Phase 0 became tablets); station_id = a home station, informative only; client_uuid of an enrolment through POST /devices, unique (branch_id, client_uuid), NULL for Phase 0 rows; token_hash = sha256 of a print bridge token, unique, CHECK devices_token_only_for_bridge (kind = bridge OR token_hash IS NULL), hidden from every answer and redacted in the audit; revoked_by = who revoked it; last_seen_at written by EnsureEnrolledDevice at most once a minute (a cache lock), not an audited change. Required on the station routes once identity.require_enrolled_device is on (tests/Support/station_routes.php)' }
Table acting_sessions { id bigint [pk]  branch_id bigint [ref: > branches.id]  user_id bigint [ref: > users.id]  device_id bigint [ref: > devices.id]  started_at timestamp  expires_at timestamp  ended_at timestamp  created_at timestamp  updated_at timestamp  Note: 'step 0.4; a verified short code opens 10 minutes of acting-as (expires_at); ended_at when the pad locks; history, never deleted (no soft delete); index (user_id, expires_at)' }

// ---- Phase 1 domain tables (Orders, step 1.3a: dining_tables, order_counters, orders, order_lines, order_line_modifiers, order_events; Payments, step 1.4: payment_channels, payments)
Table dining_tables { id bigint [pk]  branch_id bigint [ref: > branches.id]  code varchar(16)  name_en varchar(120)  name_am varchar(120)  seats tinyint  sort smallint  is_active boolean  created_by_user_id bigint [ref: > users.id]  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 1.3a (Orders); the pad table grid; unique (branch_id, code); code is what an order snapshots as table_code; state free|ordering|waiting|served|bill is computed from open orders, never stored; bilingual names (rule 9); configuration (tables.manage): soft deletes, created_by_user_id' }
Table order_counters { id bigint [pk]  branch_id bigint [ref: > branches.id]  business_date date  last_no int  updated_at timestamp  Note: 'step 1.3a; daily order numbers per branch, business_date = the branch local date (Africa/Addis_Ababa); unique (branch_id, business_date); SendOrder locks the row FOR UPDATE and increments last_no; updated in place, never deleted, no created_at' }
Table orders { id bigint [pk]  branch_id bigint [ref: > branches.id]  client_uuid char(36)  order_no int  business_date date  type varchar(20)  dining_table_id bigint [ref: > dining_tables.id]  table_code varchar(16)  status varchar(20)  created_via varchar(20)  owner_user_id bigint [ref: > users.id]  created_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  shift_instance_id bigint [ref: > shift_instances.id]  station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  subtotal "decimal(12,2)"  discount "decimal(12,2)"  tax "decimal(12,2)"  total "decimal(12,2)"  paid_total "decimal(12,2)"  refunded_total "decimal(12,2)"  deposit_amount "decimal(12,2)"  currency char(3)  notes text  sent_at datetime  settled_at datetime  paid_at datetime  closed_at datetime  refunded_at datetime  cancelled_at datetime  cancel_reason varchar(255)  voided_at datetime  void_reason varchar(255)  voided_by_user_id bigint [ref: > users.id]  void_approved_by_user_id bigint [ref: > users.id]  due_at datetime  version int  created_at timestamp  updated_at timestamp  Note: 'step 1.3a; type in dine_in|takeaway|delivery|advance (CHECK orders_type_check), status in open|sent|in_progress|ready|served|paid|closed|cancelled|voided (CHECK orders_status_check, App.Modules.Orders.Enums.OrderStatus), created_via in waiter_pad|till|admin (CHECK orders_created_via_check); never deleted (no deleted_at): ends closed, cancelled or voided; order_no and business_date given together at send (CHECK orders_numbered_on_a_business_date: null while open); unique (branch_id, client_uuid) (ADR 0003), unique (branch_id, business_date, order_no); owner_user_id = the acting waiter, else the creator; actor stamp created_by_user_id .. device_id (rule 4), shift_instance_id FK to shift_instances since step 3.2a; voided_by asked, void_approved_by gave the PIN; discount and tax 0 in Phase 1, paid_total kept by the PaymentRecorded listener; version for the live-feed merge (ADR 0009); indexes (branch_id, status), (branch_id, owner_user_id, status), (dining_table_id, status); step 2.7a (migration 17) adds deposit_amount DECIMAL(12,2) NOT NULL DEFAULT 0 (CHECK orders_deposit_amount_check, never negative) for the advance-order feature: schema only, nothing reads or writes it in Phase 2; step 4.1b (phase-4 M8, 2026_11_09_100400): refunded_total DECIMAL(12,2) NOT NULL DEFAULT 0 (CHECK orders_refunded_total_check >= 0; at or below paid_total is an application rule of Orders::refund, orders.refund.exceeds_paid) and refunded_at (the last refund); a refunded order stays closed' }
Table order_lines { id bigint [pk]  branch_id bigint [ref: > branches.id]  order_id bigint [ref: > orders.id]  client_uuid char(36)  item_id bigint [ref: > items.id]  qty "decimal(14,4)"  unit_price_snapshot "decimal(12,2)"  modifier_price_snapshot "decimal(12,2)"  line_total "decimal(12,2)"  recipe_version int  station_id bigint [ref: > stations.id]  location_id bigint [ref: > locations.id]  reservation_ref char(36) [unique]  status varchar(20)  notes varchar(500)  accepted_by_user_id bigint [ref: > users.id]  accepted_at datetime  prepared_by_user_id bigint [ref: > users.id]  ready_at datetime  served_by_user_id bigint [ref: > users.id]  served_at datetime  rejected_by_user_id bigint [ref: > users.id]  rejected_at datetime  reject_reason varchar(32)  reject_note varchar(500)  refunded_at datetime  created_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  shift_instance_id bigint [ref: > shift_instances.id]  device_id bigint [ref: > devices.id]  version int  created_at timestamp  updated_at timestamp  Note: 'step 1.3a; status in queued|accepted|ready|served|rejected|voided (CHECK order_lines_status_check, App.Modules.Orders.Enums.LineStatus), reject_reason in ingredient_spoiled|equipment_down|out_of_stock|other (CHECK order_lines_reject_reason_check), qty > 0 (CHECK order_lines_qty_positive) in units of the product; unit_price_snapshot = Prices::at(sent_at), modifier_price_snapshot = sum of the modifier price deltas per unit, line_total = qty x (unit + modifiers); recipe_version = the active recipe at send (to_order only); station_id null for a display-case line; location_id = where its stock is reserved (Inventory Locations::forProduct); reservation_ref = one reservation per line, UUIDv5 of the line client UUID (ADR 0008); never deleted; unique (branch_id, client_uuid); actor stamp, shift_instance_id FK to shift_instances since step 3.2a; indexes order_id, (branch_id, station_id, status); step 4.1b (M8): refunded_at, a line is refunded once (order_refund_lines.order_line_id unique)' }
Table order_line_modifiers { id bigint [pk]  branch_id bigint [ref: > branches.id]  order_line_id bigint [ref: > order_lines.id]  modifier_id bigint [ref: > modifiers.id]  name_en varchar(120)  name_am varchar(120)  price_delta_snapshot "decimal(12,2)"  recipe_delta_snapshot json  created_at datetime  Note: 'step 1.3a; the modifier as it was when the line was written: bilingual name, price delta per unit, recipe delta per unit [{ingredient_item_id, qty (decimal string), unit}] in base units (plain JSON); written once with the line: created_at only, never updated or deleted' }
Table order_events { id bigint [pk]  branch_id bigint [ref: > branches.id]  order_id bigint [ref: > orders.id]  order_line_id bigint [ref: > order_lines.id]  station_id bigint [ref: > stations.id]  owner_user_id bigint [ref: > users.id]  event varchar(32)  user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  approved_by_user_id bigint [ref: > users.id]  actor_station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  shift_instance_id bigint [ref: > shift_instances.id]  payload json  created_at "datetime(6)"  Note: 'step 1.3a; the order timeline, append-only: triggers order_events_forbid_update_delete_{update,delete} (MySQL/MariaDB SIGNAL 45000) / order_events_forbid_update_delete with forbid_update_delete() (PostgreSQL), model guard OrderEventsAreAppendOnly; event CHECK order_events_event_check in order.created|order.lines_replaced|order.sent|order.send_refused|line.queued|line.accepted|line.ready|line.rejected|line.served|line.voided|order.in_progress|order.ready|order.served|order.settled|order.paid|order.closed|order.cancelled|order.voided, and since step 4.3c (2026_11_02_100200, the payment half of phase-4 M9) payment.recorded|payment.voided, and since step 4.1b (2026_11_09_100500, the refund half) line.refunded|order.refunded (App.Modules.Orders.Enums.OrderEventType); id is the live-update cursor (ADR 0009): station_id = the line station (KDS), owner_user_id = the pad and till feeds; approved_by_user_id = whose PIN approved a void (of an order, or since step 4.3c of a payment: payment.voided); payment.recorded payload {payment_id, channel_code, amount, receipt}, payment.voided {payment_id, channel_code, amount, reason, by_user_id, approved_by_user_id}, line.refunded {refund_id, qty, amount, disposition, restock, movement_ids} (no station_id: off the KDS feed), order.refunded {refund_id, amount, is_full, reason, line_ids, by_user_id, approved_by_user_id}, never a file key or a URL; actor stamp user_id .. device_id, shift_instance_id FK to shift_instances since step 3.2a; no updated_at, no deleted_at; indexes (branch_id, station_id, id), (branch_id, owner_user_id, id), (order_id, id)' }
Table stock_movement_reversals { id bigint [pk]  branch_id bigint [ref: > branches.id]  movement_id bigint [unique, ref: > stock_movements.id]  reverses_movement_id bigint [unique, ref: > stock_movements.id]  created_at datetime  Note: 'step 4.1b (phase-4 M6, 2026_11_09_100200): which movement reverses which; a refund that sends a unit back into stock writes one `return` per original sale / production_consume (ref_type stock_movement, ref_id the original) and one row here; both columns UNIQUE, so an original is reversed once as a database fact (no partial index); APPEND-ONLY (triggers stock_movement_reversals_forbid_update_delete_*); written only by Inventory.Ledger.Ledger::reverse (Contracts.Reversals) in the same transaction as the return; index (branch_id, created_at)' }
Table order_refunds { id bigint [pk]  branch_id bigint [ref: > branches.id]  client_uuid char(36)  order_id bigint [ref: > orders.id]  reason varchar(255)  amount "decimal(12,2)"  is_full boolean  requested_by_user_id bigint [ref: > users.id]  approved_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  shift_instance_id bigint [ref: > shift_instances.id]  station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  created_at datetime  Note: 'step 4.1b (phase-4 M7, 2026_11_09_100300): one refund of a closed order, written by Orders::refund (Actions.RefundOrder); amount > 0 (CHECK order_refunds_amount_positive) = the refunded lines line_total, the order total when every line goes back at once; is_full = every charged line of the order has now come back; requested_by = the asker (orders.void_request), approved_by = the owner of the PIN (payments.void); unique (branch_id, client_uuid) (a replay answers the same refund); APPEND-ONLY (triggers order_refunds_forbid_update_delete_*); indexes (order_id, id), (branch_id, created_at); payment_refunds.order_refund_id points here' }
Table order_refund_lines { id bigint [pk]  branch_id bigint [ref: > branches.id]  order_refund_id bigint [ref: > order_refunds.id]  order_line_id bigint [unique, ref: > order_lines.id]  qty "decimal(14,4)"  line_amount "decimal(12,2)"  disposition varchar(16)  movement_ids json  created_at datetime  Note: 'step 4.1b (phase-4 M7): one refunded line; order_line_id UNIQUE (a line is refunded once); qty > 0 (CHECK order_refund_lines_qty_positive), line_amount >= 0 (CHECK order_refund_lines_line_amount_check) = its line_total; disposition in restock|waste (CHECK order_refund_lines_disposition_check, App.Modules.Orders.Enums.RefundDisposition), taken from the product refund settings at the moment of the refund and never rewritten; movement_ids = the reversing return movements of a restock ([] for waste); APPEND-ONLY (triggers order_refund_lines_forbid_update_delete_*); index (branch_id, created_at)' }
Table payment_channels { id bigint [pk]  branch_id bigint [ref: > branches.id]  client_uuid char(36)  code varchar(32)  name_en varchar(120)  name_am varchar(120)  is_enabled boolean  requires_photo boolean  requires_reference boolean  reference_pattern varchar(120)  reference_hint_en varchar(120)  reference_hint_am varchar(120)  photo_hint_en varchar(120)  photo_hint_am varchar(120)  sort smallint  created_by_user_id bigint [ref: > users.id]  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 1.4; unique (branch_id, code); the eight defaults (cash; telebirr, cbe_birr, cbe_bank, awash, dashen, abyssinia, coop, which need a receipt photo and a reference) are inserted for every existing branch by the migration (INSERT IGNORE) and for a new branch by the BranchCreated listener (Payments EnsureDefaultChannels); a channel that requires_photo is refused until Phase 4 (payments.channel.photo_required); soft-deleted so removed channels stay in the history of the payments made on them; created_by_user_id null for the defaults. Step 4.3a (phase-4 M3, additive, all NULL with no default, nothing backfilled): client_uuid of a channel created through POST /payment-channels, unique (branch_id, client_uuid), NULL for the defaults; reference_pattern is a regex body without delimiters that a reference must match as a whole, validated when saved (Payments.Support.ReferencePattern), NULL = any non-empty reference; reference_hint_* and photo_hint_* are the bilingual hints the till shows; the cash channel (code cash) is locked: always enabled, never removed, no photo, reference or pattern rule (payments.channel.cash_locked); sort is renumbered 1..n by PUT /payment-channels/order' }
Table payments { id bigint [pk]  branch_id bigint [ref: > branches.id]  client_uuid char(36)  batch_uuid char(36)  order_id bigint [ref: > orders.id]  channel_id bigint [ref: > payment_channels.id]  amount "decimal(12,2)"  tendered_amount "decimal(12,2)"  change_amount "decimal(12,2)"  refunded_amount "decimal(12,2)"  currency char(3)  reference_no varchar(64)  reference_norm varchar(64)  receipt_photo_key varchar(255)  receipt_file_id bigint [ref: > stored_files.id]  status varchar(20)  received_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  shift_instance_id bigint [ref: > shift_instances.id]  station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  received_at datetime  verified_by_user_id bigint [ref: > users.id]  verified_at datetime  disputed_by_user_id bigint [ref: > users.id]  disputed_at datetime  dispute_reason varchar(255)  dispute_resolved_at datetime  voided_by_user_id bigint [ref: > users.id]  voided_at datetime  void_reason varchar(255)  created_at timestamp  updated_at timestamp  Note: 'step 1.4, final schema; status in recorded|verified|disputed|voided (CHECK payments_status_check, App.Modules.Payments.Enums.PaymentStatus); never deleted (no deleted_at): voided by status in Phase 4; unique (branch_id, client_uuid) (ADR 0003); Phase 1 writes cash only, tendered_amount and change_amount are cash-only (change = tendered - amount); reference_no is never logged (the audit snapshot redacts it); receipt_photo_key is Phase 4 (object-store key, signed on read); received_by_user_id is the person who took the money (the cashier acting by short code, else the account), actor stamp acting_user_id .. device_id (rule 4), shift_instance_id FK to shift_instances since step 3.2a; indexes (order_id), (branch_id, received_at). Step 4.3b (M4): batch_uuid = the client_uuid of a split bill (payment-batches), index (branch_id, batch_uuid); reference_norm = reference_no upper case without spaces or dashes (backfilled for Phase 1 rows; redacted in the audit), index (branch_id, channel_id, reference_norm), a repeat is a warning, never unique; receipt_file_id = the receipt photo (stored_files), receipt_photo_key holds the same key (redacted in the audit); refunded_amount DEFAULT 0 (step 4.3d); the dispute columns are step 4.3c: verify sets verified_by_user_id/verified_at, dispute sets disputed_by_user_id/disputed_at/dispute_reason, a dispute resolved by verify or void sets dispute_resolved_at, a void sets voided_by_user_id (who asked; the approver is in the audit context and on the order timeline)/voided_at/void_reason; status moves recorded -> verified|disputed|voided, verified -> voided, disputed -> verified|voided; CHECK payments_amount_positive (amount > 0), payments_refunded_amount_range (0 <= refunded_amount <= amount); every channel taken from 4.3b, part payments allowed' }
Table receipt_settings { id bigint [pk]  branch_id bigint [ref: > branches.id]  business_name_en varchar(120)  business_name_am varchar(120)  address_en varchar(255)  address_am varchar(255)  phone varchar(32)  tin varchar(32)  footer_en varchar(255)  footer_am varchar(255)  show_amharic boolean  ethiopian_dates boolean  created_by_user_id bigint [ref: > users.id]  created_at timestamp  updated_at timestamp  Note: 'step 4.3e (phase-4 M5): what the receipts of a branch print at the top and the bottom; one row per branch (unique branch_id), created by the first PUT /receipt-settings (a no-op INSERT IGNORE, then the row is locked), so the table starts empty and a branch without a row reads the defaults (its name in both languages, no address, phone, TIN or footer, show_amharic on, ethiopian_dates off); business_name, address and footer are bilingual pairs; show_amharic picks the default receipt language (both, else English), ethiopian_dates prints the Ethiopian date too; changed in place and never deleted (no deleted_at, SoftDeletesTest allowlist); every save is an audit row receipt_settings.update' }

// ---- Planned, not migrated yet (Phase 2, Inventory). Listed because the manifest assigns these tables to the
// Inventory module, which is a Phase 0 module; columns are the domain model's key fields and are settled by the
// Phase 2 plan. scripts/erd_check.py reports them as "documented but no migration creates it yet" until they land.
Table suppliers { id bigint [pk]  branch_id bigint [ref: > branches.id]  name varchar(160)  phone varchar(32)  tin varchar(32)  notes varchar(500)  is_active tinyint  created_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  shift_instance_id bigint [ref: > shift_instances.id]  actor_station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 2.2a; who a purchase is bought from; a name is a proper noun (no name_en/name_am pair); configuration, so it soft-deletes and carries the actor stamp; index (branch_id, name)' }
Table purchases { id bigint [pk]  branch_id bigint [ref: > branches.id]  client_uuid char(36)  supplier_id bigint [ref: > suppliers.id]  invoice_no varchar(64)  purchase_date date  location_id bigint [ref: > locations.id]  status varchar(12)  currency char(3)  total "decimal(12,2)"  notes varchar(500)  confirmed_at datetime  confirmed_by_user_id bigint [ref: > users.id]  cancelled_at datetime  cancel_reason varchar(255)  created_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  shift_instance_id bigint [ref: > shift_instances.id]  actor_station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  version int  created_at timestamp  updated_at timestamp  Note: 'step 2.2a; draft | confirmed | cancelled (CHECK purchases_status_check, App.Modules.Inventory.Enums.PurchaseStatus); total = sum of the lines line_total; CHECKs total >= 0 and confirmed_at set exactly when confirmed; never deleted (cancelled by status); unique (branch_id, client_uuid), indexes (branch_id, status, purchase_date) and (supplier_id, invoice_no); confirm (step 2.2b) writes the purchase_in movements into location_id through the Ledger and feeds item_costs' }
Table purchase_lines { id bigint [pk]  branch_id bigint [ref: > branches.id]  purchase_id bigint [ref: > purchases.id]  client_uuid char(36)  item_id bigint [ref: > items.id]  qty "decimal(14,4)"  unit_id bigint [ref: > units.id]  qty_base "decimal(14,4)"  unit_cost "decimal(14,4)"  unit_cost_base "decimal(14,4)"  line_total "decimal(12,2)"  movement_id bigint [ref: > stock_movements.id]  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 2.2a; qty is in unit_id, qty_base in the item base unit (what the purchase_in movement carries); unit_cost is a cost RATE per unit_id and unit_cost_base per base unit, both decimal(14,4) (invariants version 2); line_total = qty x unit_cost half-up to 2 dp; unique (branch_id, client_uuid) derives the movement client_uuid; CHECKs qty > 0 and unit_cost >= 0; a draft replaced lines are soft-deleted' }
Table item_costs { id bigint [pk]  branch_id bigint [ref: > branches.id]  item_id bigint [ref: > items.id]  moving_avg_cost "decimal(14,4)"  qty_basis "decimal(14,4)"  currency char(3)  as_of datetime  version int  created_at timestamp  updated_at timestamp  Note: 'step 2.2a; the moving average per BASE unit, a cost rate (invariants version 2); new = (old_qty x old_cost + qty_in x unit_cost_in) / (old_qty + qty_in), one half-up rounding to 4 dp, old_qty = on_hand over all locations, unvalued stock (no row) does not dilute; derived state written only by Costs.CostLedger under this row FOR UPDATE lock (after stock_balances ascending (item_id, location_id), item_costs ascending item_id); unique (branch_id, item_id); no soft delete' }
Table item_cost_history { id bigint [pk]  branch_id bigint [ref: > branches.id]  item_id bigint [ref: > items.id]  source varchar(12)  purchase_line_id bigint [ref: > purchase_lines.id]  qty_before "decimal(14,4)"  cost_before "decimal(14,4)"  qty_in "decimal(14,4)"  unit_cost_in "decimal(14,4)"  cost_after "decimal(14,4)"  user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  created_at datetime  Note: 'step 2.2a; APPEND-ONLY (triggers item_cost_history_forbid_update_delete_*, forbid_update_delete() on PostgreSQL; no updated_at or deleted_at); one row per update of item_costs, written by Costs.CostLedger in the same transaction; source purchase | opening; cost_before NULL when the stock was unvalued; the average can be replayed from it; index (item_id, id)' }
Table transfers { id bigint [pk]  branch_id bigint [ref: > branches.id]  client_uuid char(36)  item_id bigint [ref: > items.id]  from_location_id bigint [ref: > locations.id]  to_location_id bigint [ref: > locations.id]  qty "decimal(14,4)"  status varchar(12)  note varchar(255)  reject_reason varchar(255)  production_request_id bigint  requested_by_user_id bigint [ref: > users.id]  requested_at datetime  decided_by_user_id bigint [ref: > users.id]  decided_at datetime  out_movement_id bigint [ref: > stock_movements.id]  in_movement_id bigint [ref: > stock_movements.id]  created_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  shift_instance_id bigint [ref: > shift_instances.id]  actor_station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  version int  created_at timestamp  updated_at timestamp  Note: 'step 2.3; a request to move stock between two locations of the branch: requested | confirmed | rejected (CHECK transfers_status_check, App.Modules.Inventory.Enums.TransferStatus); qty is in the item base unit; CHECKs qty > 0, from_location_id <> to_location_id, and decided_by_user_id / decided_at set exactly when the status is not requested; never deleted (decided by status); unique (branch_id, client_uuid), indexes (branch_id, status, from_location_id) and (to_location_id, status); a request writes no movement, a confirm writes the two transfer movements through the Ledger (out_movement_id, in_movement_id) and a reject none; production_request_id is a plain id (Inventory never reads Production)' }
Table reorder_rules { id bigint [pk]  branch_id bigint [ref: > branches.id]  item_id bigint [ref: > items.id]  location_id bigint [ref: > locations.id]  location_key bigint  min_qty "decimal(14,4)"  reorder_qty "decimal(14,4)"  notify_roles json  is_active tinyint  created_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  shift_instance_id bigint [ref: > shift_instances.id]  actor_station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  version int  created_at timestamp  updated_at timestamp  deleted_at timestamp  active_key tinyint  Note: 'step 2.6a (migration 14); the minimum an item may fall to at a place and how much to order then: when available (on_hand - reserved) is at or below min_qty the `low` alert opens (ADR 0011, StockLow); location_id NULL is a branch-wide rule (location_key 0): the sum of available over the branch stock places, never the cash drawer; min_qty and reorder_qty are in the item base unit (CHECK min_qty >= 0, reorder_qty > 0); notify_roles is a JSON list of roles from the permission registry plus the literal station (the people assigned to the station of the place), validated by App.Modules.Inventory.Reorder.ReorderRules; one LIVE rule per item and place on both engines: active_key is a STORED generated column (1 while deleted_at IS NULL, NULL after) under unique (item_id, location_key, active_key) on MariaDB and MySQL, a partial unique index reorder_rules_one_live on PostgreSQL, so a deleted rule frees its place and an inactive one still occupies it; configuration, so it soft-deletes and carries the actor stamp; version counts the changes; written only by ReorderRules inside an AuditedAction; index (branch_id, item_id)' }
Table production_requests { id bigint [pk]  branch_id bigint [ref: > branches.id]  client_uuid char(36)  product_item_id bigint [ref: > items.id]  requested_qty "decimal(14,4)"  due_at datetime  priority varchar(8)  station_id bigint [ref: > stations.id]  reason varchar(12)  status varchar(20)  requested_by_user_id bigint [ref: > users.id]  assigned_to_user_id bigint [ref: > users.id]  linked_order_id bigint  source_alert_id bigint  open_stock_out_key tinyint  note varchar(500)  accepted_at datetime  done_at datetime  cancelled_at datetime  cancel_reason varchar(255)  created_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  shift_instance_id bigint [ref: > shift_instances.id]  actor_station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  version int  created_at timestamp  updated_at timestamp  Note: 'step 2.7a (migration 15); a request for the producing station to make a to-stock product: requested | accepted | in_progress | pending_confirmation | done | cancelled (CHECK production_requests_status_check, App.Modules.Production.Enums.RequestStatus), priority normal | high | urgent and reason schedule | stock_out | manual (CHECKs); requested_qty is in the product base unit and above zero; station_id is the producing station (Catalog Routing.productionStationFor); open_stock_out_key is 1 while a stock_out request is open and NULL otherwise (CHECK: only a stock_out request holds it), unique (product_item_id, open_stock_out_key) so two jobs racing on one stock-out cannot both insert, on both engines with no partial index; linked_order_id (reserved for advance cake orders, always NULL in Phase 2) and source_alert_id (the stock_alert_states episode of an automatic request) are plain ids, Production never reads Orders and does not join Inventory tables; never deleted (ends by status, allow-listed in SoftDeletesTest); unique (branch_id, client_uuid), indexes (branch_id, status), (station_id, status) and (product_item_id, status); actor stamp created_by_user_id .. device_id, shift_instance_id FK to shift_instances since step 3.2a; version counts the changes' }
Table production_batches { id bigint [pk]  branch_id bigint [ref: > branches.id]  client_uuid char(36)  request_id bigint [ref: - production_requests.id]  station_id bigint [ref: > stations.id]  status varchar(10)  recipe_id bigint [ref: > recipes.id]  recipe_version int  planned_qty "decimal(14,4)"  produced_qty "decimal(14,4)"  waste_qty "decimal(14,4)"  consume_location_id bigint [ref: > locations.id]  output_location_id bigint [ref: > locations.id]  started_at datetime  started_by_user_id bigint [ref: > users.id]  finished_at datetime  finished_by_user_id bigint [ref: > users.id]  confirmed_at datetime  confirmed_by_user_id bigint [ref: > users.id]  send_back_note varchar(255)  send_back_count tinyint  output_movement_id bigint [ref: > stock_movements.id]  created_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  shift_instance_id bigint [ref: > shift_instances.id]  actor_station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  version int  created_at timestamp  updated_at timestamp  Note: 'step 2.7a (migration 16); the work done for one request, one batch per request (unique request_id): started | finished | confirmed (CHECK production_batches_status_check, App.Modules.Production.Enums.BatchStatus); recipe_id and recipe_version are the version the baker saw and consumption always uses it; consume_location_id and output_location_id are resolved at start so a later change of configuration does not move an open batch; quantities are in the product base unit; CHECKs planned_qty > 0, produced_qty and waste_qty never negative and, once finished, both set with a sum above zero, finished_at and finished_by_user_id set for a finished or confirmed batch, the confirmed_* columns set exactly when confirmed, and the confirmer differs from the finisher unless both happened at the same instant (a station that needs no overseer confirms in the write that finishes); output_movement_id names the production_output movement a confirm wrote; never deleted (ends by status, allow-listed in SoftDeletesTest); unique (branch_id, client_uuid), index (branch_id, status)' }
Table stock_alert_states { id bigint [pk]  branch_id bigint [ref: > branches.id]  item_id bigint [ref: > items.id]  location_id bigint [ref: > locations.id]  location_key bigint  type varchar(8)  is_active tinyint  active_since datetime  cleared_at datetime  available_at_start "decimal(14,4)"  threshold_qty "decimal(14,4)"  caused_by_user_id bigint [ref: > users.id]  created_at timestamp  updated_at timestamp  Note: 'step 2.1 (F1, ADR 0011); one row per episode of an item running out (type out) or low (type low) at a place; location_id NULL = branch-wide rule scope (step 2.6) and location_key is the location id or 0, so the unique key can include it; is_active is 1 while the episode is open and NULL once cleared (cleared_at set), unique (item_id, location_key, type, is_active) = at most one open episode per item, place and type on both engines, no partial index; CHECK type in low|out and is_active NULL or 1; written only by App.Modules.Inventory.Alerts.AlertEvaluator under the balance row lock, as the person whose movement caused it (caused_by_user_id); history, never deleted (no deleted_at, allow-listed in SoftDeletesTest); index (branch_id, is_active)' }
Table notifications { id bigint [pk]  branch_id bigint [ref: > branches.id]  user_id bigint [ref: > users.id]  type varchar(40)  severity varchar(10)  title_en varchar(160)  title_am varchar(160)  body_en varchar(1000)  body_am varchar(1000)  payload json  deep_link varchar(255)  dedupe_key varchar(120)  read_at datetime  created_at "datetime(6)"  Note: 'step 2.5a (migration 10); the in-app inbox, one row per recipient per event, with title and body in both languages (the reader locale picks one; the external drivers of 2.5b pick the recipient locale); the in_app delivery IS this row, so every notification of every type exists here; CHECKs type in the ten types of the plan (stock_low stock_out production_requested production_assigned batch_pending_confirmation batch_done transfer_requested transfer_decided line_ready line_rejected), Phase 3 count_submitted variance_decided chain_broken (2026_10_24_130100), step 4.3c payment_disputed (2026_11_02_100300) and step 4.4d weekly_summary (2026_11_07_100100, which also widened body_en and body_am from 500 to 1000 for the weekly figures and the signed PDF link) and step 4.3d order_refunded (2026_11_10_100100) and severity in info|warning|critical; unique (user_id, dedupe_key) so a redelivered event cannot write a second line (NULL keys never collide), indexes (branch_id, user_id, id) and (user_id, read_at); the only column that ever changes is read_at; history, never deleted (no deleted_at, allow-listed in SoftDeletesTest); written by the system for an event, so no actor stamp: the cause is payload.caused_by_user_id; created_at has microseconds and is the clock of the OverlapCursor poll; written only by App.Modules.Notifications.Contracts.Notifier' }
Table notification_dedupe { id bigint [pk]  branch_id bigint [ref: > branches.id]  dedupe_key varchar(120)  type varchar(40)  is_active tinyint  active_since "datetime(6)"  cleared_at "datetime(6)"  Note: 'step 2.5a (migration 13, ADR 0011); the delivery gate for episodic alerts, key stock_out:{item}:{location} (item, location, type as the manifest says); is_active is 1 while people have been told and a repeat is held, NULL once StockRecovered cleared it (cleared_at set), unique (branch_id, dedupe_key, is_active) = at most one active row per key on both engines with no partial index, so a claim is one insert the unique key arbitrates and never a SELECT FOR UPDATE on a missing row; CHECK is_active NULL or 1; cleared rows stay as history (no deleted_at, allow-listed in SoftDeletesTest); written only by App.Modules.Notifications.Support.Dedupe' }
Table notification_endpoints { id bigint [pk]  branch_id bigint [ref: > branches.id]  user_id bigint [ref: > users.id]  driver varchar(10)  address_hash char(64)  address text  user_agent varchar(255)  verified_at datetime  last_success_at datetime  revoked_at datetime  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 2.5b (migration 12); where a person can be reached outside the app: a web push subscription or a Telegram chat (sms is a slot with no gateway); CHECK driver in push|telegram|sms; address is the push subscription JSON or the chat id, ENCRYPTED at rest by the model (encrypted cast), address_hash is the sha256 of the push endpoint URL or of the chat id, so the same subscription is found again without decrypting; unique (user_id, driver, address_hash) = one row per person and address, which a revoked subscription reuses; revoked_at is set when the person turns it off or the push service says it is gone, deleted_at when the person removes it (soft delete); created before notification_deliveries because a delivery references it (the plan numbers them the other way round); Telegram link codes are not stored, they live in the cache for 10 minutes; written by App.Modules.Notifications.Actions.SubscribePush / LinkTelegramChat / RevokeEndpoint and Jobs.DeliverNotification' }
Table notification_deliveries { id bigint [pk]  branch_id bigint [ref: > branches.id]  notification_id bigint [ref: > notifications.id]  driver varchar(10)  endpoint_id bigint [ref: > notification_endpoints.id]  status varchar(10)  attempts tinyint  last_error varchar(255)  sent_at datetime  created_at timestamp  updated_at timestamp  Note: 'step 2.5b (migration 11); what was sent outside the app, one row per inbox line and endpoint (the inbox line is the in_app delivery and has no row; a driver that is off writes no row); CHECKs driver in push|telegram|sms, status in pending|sent|failed|gone (pending while it is retried, failed after the third try, gone when the push service or Telegram says the address no longer exists) and attempts >= 0; last_error is text only and never holds a key or a token; indexes (status, id) and (branch_id, notification_id); history, never deleted (no deleted_at, allow-listed in SoftDeletesTest); a failed send never touches the inbox line; written by App.Modules.Notifications.Support.DeliveryPlanner (pending) and Jobs.DeliverNotification (the rest)' }
Table shift_templates { id bigint [pk]  branch_id bigint [ref: > branches.id]  name_en varchar(80)  name_am varchar(80)  start_time time  end_time time  days_mask tinyint  is_active boolean  sort smallint  created_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  shift_instance_id bigint [ref: > shift_instances.id]  actor_station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  version int  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 3.2a (migration 3 of phase 3); a named window of the day on the days of the week, the schedule turns it into shift instances; start_time and end_time are the branch local wall-clock times, end_time earlier than start_time is the cross-midnight window (a Night 22:00 to 06:00), equal times are refused (CHECK shift_templates_window_check); days_mask bit 0 Monday .. bit 6 Sunday, the ISO weekday of the day the window STARTS (CHECK shift_templates_days_mask_check, 1 to 127; the API says days_of_week 1..7); App.Modules.Shifts.Support.ShiftWindow decides which window holds an instant (plan section 10.2); configuration, so soft deleted and audited, no client_uuid; editing a template never changes an instance already made; actor stamp created_by_user_id .. device_id with shift_instance_id now a foreign key (migration 7); index (branch_id, is_active)' }
Table shift_template_stations { id bigint [pk]  branch_id bigint [ref: > branches.id]  template_id bigint [ref: > shift_templates.id]  station_id bigint [ref: > stations.id]  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 3.2a (migration 4 of phase 3); the stations a shift template applies to; unique (template_id, station_id) even among soft-deleted rows, so a removed pair is restored, not duplicated; no actor stamp, the template audit row carries it; soft deleted' }
Table shift_instances { id bigint [pk]  branch_id bigint [ref: > branches.id]  client_uuid char(36)  station_id bigint [ref: > stations.id]  template_id bigint [ref: > shift_templates.id]  slot_key bigint  sequence tinyint  date date  starts_at datetime  ends_at datetime  origin varchar(12)  status varchar(20)  open_key tinyint  opening_mode varchar(10)  started_by_user_id bigint [ref: > users.id]  started_at datetime  opened_by_user_id bigint [ref: > users.id]  opened_at datetime  closed_by_user_id bigint [ref: > users.id]  closing_started_at datetime  submitted_at datetime  locked_at datetime  cancelled_at datetime  cancelled_by_user_id bigint [ref: > users.id]  cancel_reason varchar(255)  created_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  actor_station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  version int  created_at timestamp  updated_at timestamp  Note: 'step 3.2a (migration 5 of phase 3, ADR 0013); a template on a date at a station, or an ad-hoc shift; status scheduled|opening|open|counting|pending_approval|locked|cancelled (CHECK shift_instances_status_check, App.Modules.Shifts.Enums.ShiftStatus), origin scheduled|started|call_in, opening_mode counted|carried or null until it opens; never deleted (no deleted_at, ends locked or cancelled, allow-listed in SoftDeletesTest); date is the LOCAL start date in the branch timezone, not the UTC date and not the date it ends (plan section 10.2), starts_at and ends_at are the template window of that date in UTC or null for an ad-hoc shift; slot_key is the template id or 0 (CHECK slot_key = COALESCE(template_id, 0)) and sequence numbers the instances of one slot on one date; open_key is 1 while the status is opening, open or counting and NULL otherwise (CHECK shift_instances_open_key_check), so the unique key (station_id, open_key) is at most one running shift per station, enforced by the database on both engines with no partial index (NULLs are distinct, ADR 0011 technique); CHECKs tie locked_at, cancelled_at and opened_at to the status; unique (branch_id, client_uuid), unique (station_id, open_key), unique (station_id, date, slot_key, sequence); indexes (branch_id, date), (branch_id, status), (station_id, status); actor stamp without shift_instance_id (the row is the shift); version is the live feed merge key' }
Table shift_roster { id bigint [pk]  branch_id bigint [ref: > branches.id]  shift_instance_id bigint [ref: > shift_instances.id]  user_id bigint [ref: > users.id]  source varchar(12)  joined_at datetime  left_at datetime  created_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  device_id bigint [ref: > devices.id]  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 3.2a (migration 6 of phase 3, ADR 0013 rule 4); who is on a shift; on duty = joined_at set and left_at null on the running shift, joined_at is null while someone is only scheduled; source scheduled|started|call_in|joined (CHECK shift_roster_source_check); CHECK left_at is null or joined_at is set and left_at >= joined_at; soft deleted only while the shift has not started (a scheduled person removed), once it has started the row is history and only left_at moves; unique (shift_instance_id, user_id); index (user_id, joined_at)' }
Table variance_reasons { id bigint [pk]  branch_id bigint [ref: > branches.id]  code varchar(32)  name_en varchar(80)  name_am varchar(80)  requires_note boolean  is_active boolean  sort smallint  created_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  shift_instance_id bigint [ref: > shift_instances.id]  actor_station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  version int  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 3.3a; why a counted figure differs from the ledger; bilingual (rule 9); the five defaults (spoilage, breakage, miscount, theft_suspected, other which requires a note) are given to every branch by the migration (idempotent INSERT IGNORE, never touches an edited or removed row) and by the BranchCreated listener; unique (branch_id, code) also covers soft-deleted rows; index (branch_id, is_active, sort); soft deletes' }
Table stock_counts { id bigint [pk]  branch_id bigint [ref: > branches.id]  client_uuid char(36)  shift_instance_id bigint [ref: > shift_instances.id]  location_id bigint [ref: > locations.id]  type varchar(8)  seq tinyint  status varchar(20)  counted_by_user_id bigint [ref: > users.id]  started_at datetime  snapshot_at "datetime(6)"  ledger_movement_id bigint [ref: > stock_movements.id]  submitted_at datetime  cosigned_by_user_id bigint [ref: > users.id]  cosigned_at datetime  decision varchar(10)  decided_by_user_id bigint [ref: > users.id]  decided_at datetime  decision_note varchar(500)  supersede_cause varchar(10)  unlock_reason varchar(255)  superseded_by_id bigint [ref: > stock_counts.id]  superseded_at datetime  chain_seq int  previous_hash char(64)  payload_hash char(64)  payload_version tinyint  canonical_payload mediumtext  locked_at "datetime(6)"  locked_by_user_id bigint [ref: > users.id]  created_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  actor_station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  version int  created_at timestamp  updated_at timestamp  Note: 'step 3.3a; a count of one location at one shift boundary, never deleted (CountStatus: draft, awaiting_cosign, pending_approval, approved, locked, rejected); client_uuid derived by the server (UUIDv5 of count:{shift}:{location}:{type}:{seq}); seq counts revisions (recount, unlock); snapshot_at is the instant the balances were read under Ledger::lock at submit, ledger_movement_id the newest movement then; the lock columns (chain_seq .. locked_by_user_id) are created now for step 3.4 and are all set exactly when status is locked (CHECK); CHECKs for type, status, seq >= 1, decision, supersede_cause, chain_seq >= 1, decision set exactly when decided_at is; unique (branch_id, client_uuid), (shift_instance_id, location_id, type, seq), (branch_id, location_id, chain_seq); rule R-A (one unresolved count per place) is code' }
Table stock_count_lines { id bigint [pk]  branch_id bigint [ref: > branches.id]  count_id bigint [ref: > stock_counts.id]  item_id bigint [ref: > items.id]  expected_qty "decimal(14,4)"  carried_qty "decimal(14,4)"  counted_qty "decimal(14,4)"  variance_qty "decimal(14,4)"  confirmed_at datetime  variance_reason_id bigint [ref: > variance_reasons.id]  variance_note varchar(255)  reason_status varchar(10)  decision_note varchar(255)  adjustment_movement_id bigint [ref: > stock_movements.id]  photo_key varchar(255)  created_at timestamp  updated_at timestamp  Note: 'step 3.3a; the lines are the variance: expected (ledger on_hand at the snapshot, null while draft), carried (opening prefill), counted (CHECK >= 0), variance = counted - expected, confirmed_at null until the counter touches the line; reason_status none|pending|accepted|rejected (CHECK); frozen by triggers stock_count_lines_freeze_insert / _freeze_update / _forbid_delete (MariaDB; one stock_count_lines_guard function on PostgreSQL): no insert unless the parent count is a draft, no update of any column but reason_status, decision_note, adjustment_movement_id and updated_at unless it is a draft, none at all once it is locked, no delete ever; photo_key reserved (Phase 4); unique (count_id, item_id)' }
Table cash_declarations { id bigint [pk]  branch_id bigint [ref: > branches.id]  count_id bigint [ref: - stock_counts.id]  shift_instance_id bigint [ref: > shift_instances.id]  denominations json  counted_total "decimal(12,2)"  expected_total "decimal(12,2)"  variance_total "decimal(12,2)"  carried_float_total "decimal(12,2)"  cash_sales_total "decimal(12,2)"  float_left_total "decimal(12,2)"  channel_counts json  variance_reason_id bigint [ref: > variance_reasons.id]  variance_note varchar(255)  currency char(3)  confirmed_at datetime  created_at timestamp  updated_at timestamp  Note: 'step 3.5; the cash of the till drawer, one per cash-drawer count (the stock_counts row at the station cash_drawer location, so it has the count lifecycle, approval, lock and chain); denominations is {"200": 3, ..} of every configured denomination (config shifts.denominations), counted_total is worked out by the server in Money; expected_total, variance_total, carried_float_total (opening) and cash_sales_total (closing, Payments Totals::cash) are written at the submit under the locks and null while a draft; float_left_total is what stays in the drawer for the next shift (closing); channel_counts is the declared figures while a draft and the reconciliation table from the submit; confirmed_at null until the cashier has declared; CHECKs counted_total >= 0, float_left_total between 0 and counted_total; unique (count_id); frozen by triggers cash_declarations_freeze_insert / _freeze_update / _forbid_delete (MariaDB; one cash_declarations_guard function on PostgreSQL): no insert or update unless the parent count is a draft, none at all once it is locked, no delete ever; no actor stamp, the count carries it' }
Table payment_refunds { id bigint [pk]  branch_id bigint [ref: > branches.id]  client_uuid char(36)  order_id bigint [ref: > orders.id]  order_refund_id bigint [ref: > order_refunds.id]  payment_id bigint [ref: > payments.id]  channel_id bigint [ref: > payment_channels.id]  amount "decimal(12,2)"  reference_no varchar(64)  proof_file_id bigint [ref: > stored_files.id]  refunded_by_user_id bigint [ref: > users.id]  approved_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  shift_instance_id bigint [ref: > shift_instances.id]  station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  refunded_at datetime  created_at datetime  Note: 'step 4.1c (phase-4 M10), written since step 4.3d (POST /orders/{order}/refund; client_uuid UUIDv5 of the refund's client_uuid and the payment): one row per payment a refund was paid back through; APPEND-ONLY (triggers payment_refunds_forbid_update_delete_*); amount > 0 (CHECK payment_refunds_amount_positive); order_refund_id has its FK to order_refunds since step 4.1b (2026_11_09_100300), proof_file_id its FK to stored_files (added by step 4.2a); unique (branch_id, client_uuid); indexes (branch_id, refunded_at), (payment_id); read by Payments.Contracts.Facts::refunds (clock refunded_at); nothing writes it before step 4.3d' }
Table handover_notes { id bigint [pk]  branch_id bigint [ref: > branches.id]  client_uuid char(36)  shift_instance_id bigint [ref: > shift_instances.id]  from_user_id bigint [ref: > users.id]  to_user_id bigint [ref: > users.id]  body varchar(1000)  created_by_user_id bigint [ref: > users.id]  acting_user_id bigint [ref: > users.id]  actor_station_id bigint [ref: > stations.id]  device_id bigint [ref: > devices.id]  created_at "datetime(6)"  Note: 'step 3.6; what the outgoing shift leaves for the incoming one, written on a running shift (or one waiting for approval) and kept with it; append-only by triggers handover_notes_forbid_update_delete_update / _delete (MariaDB; forbid_update_delete on PostgreSQL), a correction is a new note, so no updated_at or deleted_at; from_user_id is the person who wrote it (the short-code actor, else the account), to_user_id a named colleague or null for the next shift; body is 1 to 1000 characters of free text in the writer language (CHECK char_length > 0), no _en/_am pair; unique (branch_id, client_uuid) so an offline replay writes nothing twice; indexes (shift_instance_id, id) and (branch_id, id) for the polled feed overlap cursor' }
Table analytics_days { branch_id bigint [ref: > branches.id]  day date  version int  rebuilt_at "datetime(6)"  trigger varchar(16)  duration_ms int  row_counts json  fingerprint char(64)  changed boolean  indexes { (branch_id, day) [pk] }  Note: 'step 4.4a (phase-4 M12, ADR 0014): one row per branch and LOCAL day that Analytics.Contracts.Rebuild::day has built; primary key (branch_id, day); the lock target of a rebuild (created by an upsert that changes nothing, then SELECT ... FOR UPDATE, never a lock on a missing row) and the freshness feed of the dashboards (4.4b); version counts the rebuilds, trigger in shift_locked|nightly|manual|touch|seed (CHECK analytics_days_trigger_check), row_counts is table => rows written, fingerprint the sha256 of the canonical day (Build.Fingerprint), changed whether it differs from the run before; derived data: no client_uuid, actor stamp or deleted_at' }
Table daily_sales { branch_id bigint [ref: > branches.id]  day date  orders_count int  items_qty "decimal(14,4)"  subtotal "decimal(12,2)"  discount_total "decimal(12,2)"  tax_total "decimal(12,2)"  revenue "decimal(12,2)"  avg_ticket "decimal(12,2)"  voided_count int  voided_total "decimal(12,2)"  cancelled_count int  refund_count int  refund_total "decimal(12,2)"  net_revenue "decimal(12,2)"  dine_in_revenue "decimal(12,2)"  takeaway_revenue "decimal(12,2)"  delivery_revenue "decimal(12,2)"  advance_revenue "decimal(12,2)"  rebuilt_at "datetime(6)"  indexes { (branch_id, day) [pk] }  Note: 'step 4.4a (phase-4 M13, ADR 0014): one row per built LOCAL day (zeros on a quiet day); sales = paid and closed orders by settled_at, voided_* by voided_at, cancelled_count by cancelled_at, refunds by refunded_at (cash basis, refund_count counts refunds not their payment rows); net_revenue = revenue - refund_total; written only by Rebuild::day (the day replaced in one transaction); derived data' }
Table daily_hour_sales { branch_id bigint [ref: > branches.id]  day date  hour tinyint  orders_count int  items_qty "decimal(14,4)"  revenue "decimal(12,2)"  rebuilt_at "datetime(6)"  indexes { (branch_id, day, hour) [pk] }  Note: 'step 4.4a (phase-4 M13): the day sales by the LOCAL hour of settled_at, 0 to 23 (CHECK daily_hour_sales_hour_check), one row per hour that sold something; derived data' }
Table daily_channel_totals { branch_id bigint [ref: > branches.id]  day date  channel_id bigint [ref: > payment_channels.id]  receipts_count int  amount "decimal(12,2)"  refund_count int  refund_amount "decimal(12,2)"  net_amount "decimal(12,2)"  without_reference_count int  without_photo_count int  verified_count int  disputed_count int  duplicate_reference_count int  rebuilt_at "datetime(6)"  indexes { (branch_id, day, channel_id) [pk] }  Note: 'step 4.4a (phase-4 M14): per LOCAL day and channel, live payments by received_at (disputed ones count, voided ones do not) and refunds by refunded_at; net_amount = amount - refund_amount; without_reference / without_photo counted literally as Payments reconciliation does; duplicate_reference_count from Payments R-B rule through its Facts port; derived data' }
Table daily_item_metrics { branch_id bigint [ref: > branches.id]  day date  item_id bigint [ref: > items.id]  category_id bigint [ref: > categories.id]  kind varchar(10)  units_sold_qty "decimal(14,4)"  refunded_qty "decimal(14,4)"  produced_qty "decimal(14,4)"  consumed_qty "decimal(14,4)"  waste_qty "decimal(14,4)"  purchased_qty "decimal(14,4)"  adjusted_qty "decimal(14,4)"  stockout_count int  closing_on_hand_qty "decimal(14,4)"  revenue "decimal(12,2)"  cogs_total "decimal(12,2)"  margin_total "decimal(12,2)"  closing_value_total "decimal(12,2)"  cogs_complete boolean  rebuilt_at "datetime(6)"  indexes { (branch_id, day, item_id) [pk] }  Note: 'step 4.4a (phase-4 M15, ADR 0014, R-K): per LOCAL day and item; units, revenue and COGS from the lines of the day sales (settled_at), movement figures by created_at, stock-outs begun that day, closing on-hand at the end of the day valued at the day cost; cogs_total = units x the cost of the snapshotted recipe version at the day moving average, rounded once, cogs_complete false when anything was missing (never estimated); kind in ingredient|product (CHECK daily_item_metrics_kind_check); refunded_qty 0 until order refunds exist (4.1b); index (branch_id, item_id, day); derived data' }
Table daily_station_metrics { branch_id bigint [ref: > branches.id]  day date  station_id bigint [ref: > stations.id]  tickets_count int  lines_served int  lines_rejected int  avg_prep_seconds int  p90_prep_seconds int  prep_samples int  prep_seconds_sum bigint  batches_finished int  produced_qty "decimal(14,4)"  waste_qty "decimal(14,4)"  shifts_count int  shifts_locked_count int  variance_line_count int  cash_variance_total "decimal(12,2)"  stockout_count int  rebuilt_at "datetime(6)"  indexes { (branch_id, day, station_id) [pk] }  Note: 'step 4.4a (phase-4 M16, ADR 0014, plan 10.5): per LOCAL day and station; lines by their own ready_at / served_at / rejected_at, prep = accepted_at to ready_at (mean and nearest-rank p90, whole seconds, null without a sample); batches by finished_at; shifts counted on every local day from opening to lock (a Night shift on two), their variance lines and cash variance on the shift date only; stock-outs at the station places; prep_samples and prep_seconds_sum (step 4.4c, 2026_11_06_100100) are the samples of the mean and their seconds added, so a range's mean is exact; derived data' }
Table daily_user_metrics { branch_id bigint [ref: > branches.id]  day date  user_id bigint [ref: > users.id]  role_kind varchar(10)  orders_count int  items_qty "decimal(14,4)"  revenue "decimal(12,2)"  payments_count int  payments_amount "decimal(12,2)"  voids_count int  refunds_count int  lines_prepared int  avg_prep_seconds int  prep_samples int  prep_seconds_sum bigint  rebuilt_at "datetime(6)"  indexes { (branch_id, day, user_id, role_kind) [pk] }  Note: 'step 4.4a (phase-4 M16): per LOCAL day, person and role kind (waiter|cashier|station by CHECK daily_user_metrics_role_kind_check: what the person did, not the role held); waiter = orders owned settled that day and voids asked for, cashier = payments taken and refunds paid back, station = lines readied and their mean prep time (with prep_samples and prep_seconds_sum, step 4.4c); derived data' }
