// bakery-ops ERD (DBML). Regenerated/extended every phase; scripts/erd_check.py fails CI when a
// migration creates a table that is not documented here. Laravel's framework tables are listed
// so the check stays honest; domain tables are added as their migrations land.

Project bakery_ops {
  database_type: 'MySQL'
  Note: 'Phase 0 skeleton. Money DECIMAL(12,2), quantities DECIMAL(14,4) in base units. branch_id on every tenant table. Live engine MySQL 8 (ADR 0006); schema kept portable to PostgreSQL.'
}

// ---- Laravel framework tables (shipped with the scaffold)
Table users {
  id bigint [pk]
  name varchar
  email varchar [unique]
  email_verified_at timestamp
  password varchar
  remember_token varchar
  created_at timestamp
  updated_at timestamp
  Note: 'Phase 0.4 extends: branch_id, phone, short_code_hash, locale, is_active, photo_url, soft delete'
}
Table password_reset_tokens { email varchar [pk]  token varchar  created_at timestamp }
Table sessions { id varchar [pk]  user_id bigint  ip_address varchar  user_agent text  payload text  last_activity int }
Table cache { key varchar [pk]  value text  expiration int }
Table cache_locks { key varchar [pk]  owner varchar  expiration int }
Table jobs { id bigint [pk]  queue varchar  payload text  attempts smallint  reserved_at int  available_at int  created_at int }
Table job_batches { id varchar [pk]  name varchar  total_jobs int  pending_jobs int  failed_jobs int  failed_job_ids text  options text  cancelled_at int  created_at int  finished_at int }
Table failed_jobs { id bigint [pk]  uuid varchar [unique]  connection text  queue text  payload text  exception text  failed_at timestamp }

// ---- Phase 0 domain tables (branches, stations, idempotency_keys migrated in step 0.2; the rest planned ahead of their migrations)
Table branches { id bigint [pk]  name varchar(120)  timezone varchar(64)  currency char(3)  settings json  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'the tenant (step 0.2); timezone defaults to Africa/Addis_Ababa, currency to ETB; settings is plain JSON (no DB default, the model supplies {})' }
Table stations { id bigint [pk]  branch_id bigint [ref: > branches.id]  code varchar(20)  name_en varchar(120)  name_am varchar(120)  requires_overseer boolean  sort smallint  created_at timestamp  updated_at timestamp  deleted_at timestamp  Note: 'step 0.2; code in till|kitchen|bar|cake_room|bakery|store (CHECK constraint stations_code_check); unique (branch_id, code)' }
Table idempotency_keys { id bigint [pk]  branch_id bigint [ref: > branches.id]  user_id bigint  key varchar(255)  request_hash char(64)  response_status smallint  response_body json  expires_at timestamp  created_at timestamp  updated_at timestamp  Note: 'step 0.2; unique (branch_id, user_id, key); user_id has no FK (Shared is the leaf, ADR 0001); index expires_at' }
Table audit_log { id bigint [pk]  branch_id bigint [ref: > branches.id]  actor_id bigint  acting_user_id bigint  action varchar(100)  subject_type varchar(191)  subject_id bigint  before json  after json  context json  shift_instance_id bigint  station_id bigint  device_id bigint  ip varchar(45)  at timestamp  Note: 'step 0.3; append-only: triggers audit_log_forbid_update_delete_{update,delete} (MySQL SIGNAL 45000) / forbid_update_delete() (PostgreSQL); written by AuditedAction in the write transaction; no timestamps, no soft delete; actor/acting/shift/station/device ids have no FK (Audit is a leaf, ADR 0001); indexes (branch_id, at), (subject_type, subject_id); context = reason/notes that are not subject attributes; recordEvent() stores its payload in after' }
Table units { id bigint [pk]  code varchar  base_unit_id bigint  factor "numeric(14,4)" }
Table categories { id bigint [pk]  branch_id bigint  kind varchar  name_en varchar  name_am varchar  parent_id bigint  sort int }
Table items { id bigint [pk]  branch_id bigint  kind varchar  name_en varchar  name_am varchar  category_id bigint  unit_id bigint  sku varchar  is_active boolean  is_new_until date  default_batch_qty "numeric(14,4)"  deleted_at timestamp }
Table item_prices { id bigint [pk]  item_id bigint  price "numeric(12,2)"  currency varchar  effective_from timestamp  effective_to timestamp }
Table item_station_assignments { item_id bigint  station_id bigint }
Table recipes { id bigint [pk]  product_item_id bigint  yield_qty "numeric(14,4)"  yield_unit_id bigint  version int  is_active boolean }
Table recipe_lines { id bigint [pk]  recipe_id bigint  ingredient_item_id bigint  qty "numeric(14,4)"  unit_id bigint  is_optional boolean  waste_pct "numeric(5,2)" }
Table recipe_steps { id bigint [pk]  recipe_id bigint  order int  text_en text  text_am text }
Table modifiers { id bigint [pk]  item_id bigint  name_en varchar  name_am varchar  price_delta "numeric(12,2)"  recipe_delta jsonb }
Table locations { id bigint [pk]  branch_id bigint  name varchar  station_id bigint  type varchar }
Table stock_movements { id bigint [pk]  branch_id bigint  item_id bigint  from_location_id bigint  to_location_id bigint  qty "numeric(14,4)"  reason varchar  ref_type varchar  ref_id bigint  reservation_ref uuid  shift_instance_id bigint  user_id bigint  acting_user_id bigint  station_id bigint  device_id bigint  client_uuid uuid  created_at timestamp  Note: 'append-only; sole writer Ledger' }
Table stock_balances { id bigint [pk]  branch_id bigint  item_id bigint  location_id bigint  on_hand "numeric(14,4)"  reserved "numeric(14,4)"  updated_at timestamp  Note: 'row-lock target (ADR 0002)' }
Table user_station_assignments { user_id bigint  station_id bigint  can_count boolean  is_overseer boolean }
Table devices { id bigint [pk]  branch_id bigint  name varchar  fingerprint varchar  enrolled_by bigint  enrolled_at timestamp  revoked_at timestamp }
Table acting_sessions { id bigint [pk]  user_id bigint  device_id bigint  started_at timestamp  expires_at timestamp  ended_at timestamp }
