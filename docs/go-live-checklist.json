{
  "$schema": "./go-live-checklist.schema.json",
  "schema": 1,
  "phase": 5,
  "items": [
    { "id": "gates-green", "title": "gate-p0 to gate-p4 still green",
      "required": true, "who": "CI", "verifier": { "type": "ci_job", "jobs": ["gate-p4"] },
      "note": "since 2026-11-12 the gates run side by side: gate-p5 needs every job gate-p4 needs, which are every job of phases 0 to 4; gate-p4 is a required check of its own on the same commit" },
    { "id": "branch-protection", "title": "main requires gate-p0 to gate-p5",
      "required": true, "who": "CI",
      "verifier": { "type": "script", "run": ["python3", "scripts/ops/check_branch_protection.py", "--require", "gate-p0..gate-p5"] } },
    { "id": "device-enforcement", "title": "An unknown device gets 403 on station routes; admin routes are unaffected",
      "required": true, "who": "CI", "verifier": { "type": "ci_job", "jobs": ["e2e-p5", "self"] },
      "note": "self is the gate job's own gate:p5 Pest step (step 5.6b)" },
    { "id": "offline-replay", "title": "An order sent offline replays once: the server has exactly one order",
      "required": true, "who": "CI", "verifier": { "type": "ci_job", "jobs": ["e2e-p5"] } },
    { "id": "print-emulator", "title": "Receipt bytes decode to the golden images; the bridge's own tests pass",
      "required": true, "who": "CI", "verifier": { "type": "ci_job", "jobs": ["print-bridge", "self"] },
      "note": "print-bridge is a need of gate-p5 since step 5.3b added the job" },
    { "id": "i18n-strict", "title": "Parity strict, API parity, every am screen swept",
      "required": true, "who": "CI",
      "verifier": [
        { "type": "ci_job", "jobs": ["i18n-check", "e2e-p5"] },
        { "type": "script", "run": ["python3", "scripts/check_invariants.py", "--i18n", "--strict-i18n"] }
      ] },
    { "id": "backup-drill-ci", "title": "A dump restores into a scratch database and passes the ledger tests",
      "required": true, "who": "CI", "verifier": { "type": "ci_job", "jobs": ["backup-drill"] },
      "note": "the job is a placeholder until step 5.5b; the gate's phase-marker row fails while it is" },
    { "id": "load-test", "title": "k6 load test within its thresholds",
      "required": true, "who": "CI", "verifier": { "type": "ci_job", "jobs": ["perf-load"] },
      "note": "perf-load joins the needs of gate-p5 in step 5.6b, once step 5.5d has added the job" },
    { "id": "live-ops", "title": "Live: a good backup in the last 26 h, a passing drill in the last 8 days",
      "required": true, "who": "CI",
      "verifier": { "type": "ci_job", "workflow": "deploy.yml", "job": "live-e2e", "branch": "main", "max_age_days": 7 },
      "note": "the deploy's @live stage reads the System page; matched by the job id or its display name" },
    { "id": "uptime-monitor", "title": "The uptime workflow exists and has passed in the last day",
      "required": true, "who": "CI",
      "verifier": [
        { "type": "file_exists", "paths": [".github/workflows/uptime.yml"] },
        { "type": "ci_job", "workflow": "uptime.yml", "branch": "main", "max_age_days": 1 }
      ],
      "note": "added in step 5.5c" },
    { "id": "handbook", "title": "Admin handbook and training plan",
      "required": true, "who": "CI",
      "verifier": { "type": "file_exists", "paths": [
        "docs/handbook/README.md",
        "docs/handbook/opening-and-closing.md",
        "docs/handbook/tablets.md",
        "docs/handbook/printer.md",
        "docs/handbook/refunds-and-voids.md",
        "docs/handbook/counts-and-handover.md",
        "docs/handbook/offline.md",
        "docs/handbook/system-page.md",
        "docs/handbook/backups.md",
        "docs/handbook/channels.md",
        "docs/handbook/dashboards.md",
        "docs/handbook/training.md"
      ] } },
    { "id": "on-call-plan", "title": "On-call plan, by role",
      "required": true, "who": "CI", "verifier": { "type": "file_exists", "paths": ["docs/runbook/on-call.md"] } },
    { "id": "restore-runbook", "title": "Backup and restore runbook",
      "required": true, "who": "CI", "verifier": { "type": "file_exists", "paths": ["docs/runbook/backup-restore.md"] },
      "note": "written in step 5.5b" },
    { "id": "print-runbook", "title": "Print bridge runbook",
      "required": true, "who": "CI", "verifier": { "type": "file_exists", "paths": ["docs/runbook/print-bridge.md"] },
      "note": "written in steps 5.3b and 5.3c" },
    { "id": "adrs", "title": "ADRs 0017 to 0021",
      "required": true, "who": "CI",
      "verifier": { "type": "file_exists", "paths": [
        "docs/adr/0017-device-enrolment-and-enforcement.md",
        "docs/adr/0018-offline-outbox-and-conflicts.md",
        "docs/adr/0019-printing-through-a-pull-bridge.md",
        "docs/adr/0020-backups-and-restore-drills-on-a-shared-host.md",
        "docs/adr/0021-observability-on-a-shared-host.md"
      ] } },
    { "id": "devices-enrolled", "title": "Every shop tablet is enrolled, and device enforcement may go on",
      "required": true, "who": "Ramin",
      "verifier": { "type": "file_exists", "paths": ["docs/go-live/signoffs/devices-enrolled.md"], "signoff": true },
      "note": "Q6, D9: a one-line PR then flips the device-enforcement default to on" },
    { "id": "print-bridge-shop", "title": "The bridge runs on the shop computer and the shop printer prints a bilingual receipt with the right TIN",
      "required": true, "who": "Ramin",
      "verifier": { "type": "file_exists", "paths": ["docs/go-live/signoffs/print-bridge-shop.md"], "signoff": true },
      "note": "Q3, Q10" },
    { "id": "am-reviewed", "title": "A fluent reviewer has read the Amharic dictionary",
      "required": true, "who": "Ramin",
      "verifier": { "type": "file_exists", "paths": ["docs/go-live/signoffs/am-reviewed.md"], "signoff": true },
      "note": "Q5" },
    { "id": "training-done", "title": "Training sessions held for every role",
      "required": true, "who": "Ramin",
      "verifier": { "type": "file_exists", "paths": ["docs/go-live/signoffs/training-done.md"], "signoff": true },
      "note": "Q7; the sessions are in docs/handbook/training.md" },
    { "id": "on-call-agreed", "title": "The on-call people agree to the on-call plan",
      "required": true, "who": "Ramin",
      "verifier": { "type": "file_exists", "paths": ["docs/go-live/signoffs/on-call-agreed.md"], "signoff": true },
      "note": "Q7; names and phone numbers stay outside the repository" },
    { "id": "offsite-backup", "title": "An off-site backup is configured and one copy verified, or the host-only risk is accepted",
      "required": true, "who": "Ramin",
      "verifier": { "type": "file_exists", "paths": ["docs/go-live/signoffs/offsite-backup.md"], "signoff": true },
      "note": "Q2" },
    { "id": "error-tracking", "title": "Error tracking is on and a test event was seen, or going live without it is accepted",
      "required": true, "who": "Ramin",
      "verifier": { "type": "file_exists", "paths": ["docs/go-live/signoffs/error-tracking.md"], "signoff": true },
      "note": "Q1" },
    { "id": "receipt-wording", "title": "The customer receipt wording (not a fiscal receipt) is accepted for the shop",
      "required": true, "who": "Ramin",
      "verifier": { "type": "file_exists", "paths": ["docs/go-live/signoffs/receipt-wording.md"], "signoff": true },
      "note": "Q9" },
    { "id": "push-telegram", "title": "Web push and Telegram keys",
      "required": false, "who": "Ramin",
      "verifier": { "type": "file_exists", "paths": ["docs/go-live/signoffs/push-telegram.md"], "signoff": true },
      "note": "Q4: optional, not a go-live blocker" }
  ]
}
